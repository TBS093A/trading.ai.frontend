/*
 * Build+push+deploy pipeline for trading-ai-frontend. See trading.ai.backend's Jenkinsfile.build
 * header comment for the webhook-filtering, test/coverage, and PR-comment design notes - same
 * shape here.
 *
 * Test & Coverage is safe to run blocking here (no catchError) - `react-scripts test --coverage`
 * against zero test files just reports 0% and exits 0 (--passWithNoTests), nothing external to
 * fail against. Once real tests exist this becomes a real gate for free.
 *
 * Credentials needed in Jenkins (already exist, shared with other pipelines):
 *   registry-credentials   (Username with password) - registry.00x097.com login
 *   git-gitea-tbs093a      (Username with password) - push access to cloud.config + PR comments
 */
pipeline {
    agent {
        node {
            label 'docker-builder && linux'
        }
    }

    triggers {
        GenericTrigger(
            genericVariables: [
                [key: 'action', value: '$.action'],
                [key: 'pr_number', value: '$.number']
            ],
            token: 'trading-ai-frontend-build',
            regexpFilterText: '$action',
            regexpFilterExpression: '^(opened|synchronize|reopened|)$'
        )
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Test & Coverage') {
            steps {
                sh '''
                    set -euo pipefail
                    docker run --rm -v "$WORKSPACE:/src" -w /src node:24.12.0-bookworm \
                        bash -c "npm ci && CI=true npm test -- --coverage --watchAll=false --passWithNoTests"
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'coverage/**', allowEmptyArchive: true
                }
            }
        }

        stage('SAST - Semgrep') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    sh '''
                        set -euo pipefail
                        docker run --rm -v "$WORKSPACE:/src" semgrep/semgrep \
                            semgrep scan --config=auto --json --output=/src/semgrep-report.json /src
                    '''
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'semgrep-report.json', allowEmptyArchive: true
                }
            }
        }

        stage('SCA - dependencies (Trivy fs)') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    sh '''
                        set -euo pipefail
                        docker run --rm -v "$WORKSPACE:/src" aquasec/trivy fs \
                            --format json --output /src/trivy-fs-report.json \
                            --severity HIGH,CRITICAL /src
                    '''
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'trivy-fs-report.json', allowEmptyArchive: true
                }
            }
        }

        stage('Build & push image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'registry-credentials',
                        usernameVariable: 'REGISTRY_USER',
                        passwordVariable: 'REGISTRY_PASS'
                    )
                ]) {
                    sh '''
                        set -euo pipefail
                        docker build \
                            --build-arg REACT_APP_API_URL=https://api.00x097.com \
                            -t registry.00x097.com/trading-ai-frontend:${GIT_COMMIT} .
                        echo "$REGISTRY_PASS" | docker login registry.00x097.com -u "$REGISTRY_USER" --password-stdin
                        docker push registry.00x097.com/trading-ai-frontend:${GIT_COMMIT}
                        docker logout registry.00x097.com
                    '''
                }
            }
        }

        stage('SCA - image (Trivy image)') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'registry-credentials',
                            usernameVariable: 'REGISTRY_USER',
                            passwordVariable: 'REGISTRY_PASS'
                        )
                    ]) {
                        sh '''
                            set -euo pipefail
                            docker run --rm \
                                --env TRIVY_USERNAME="$REGISTRY_USER" \
                                --env TRIVY_PASSWORD="$REGISTRY_PASS" \
                                -v "$WORKSPACE:/out" \
                                aquasec/trivy image \
                                --format json --output /out/trivy-image-report.json \
                                --severity HIGH,CRITICAL \
                                registry.00x097.com/trading-ai-frontend:${GIT_COMMIT}
                        '''
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'trivy-image-report.json', allowEmptyArchive: true
                }
            }
        }

        stage('Bump cloud.config manifest') {
            when {
                expression { return !env.pr_number?.trim() }
            }
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'git-gitea-tbs093a',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_TOKEN'
                    )
                ]) {
                    sh '''
                        set -euo pipefail
                        rm -rf .cloud-config-bump
                        git clone "https://${GIT_USERNAME}:${GIT_TOKEN}@git.00x097.com/tbs093a/cloud.config.git" .cloud-config-bump
                        cd .cloud-config-bump

                        yq eval -i '
                          (.. | select(tag == "!!str" and test("registry.development.svc.cluster.local:5000/trading-ai-frontend:")))
                          |= sub("registry.development.svc.cluster.local:5000/trading-ai-frontend:.*",
                                 "registry.development.svc.cluster.local:5000/trading-ai-frontend:'"${GIT_COMMIT}"'")
                        ' kubernetes/apps/trading-ai-frontend/manifest.yaml

                        git config user.email "jenkins@00x097.com"
                        git config user.name "Jenkins (trading-ai-frontend)"
                        if git diff --quiet kubernetes/apps/trading-ai-frontend/; then
                            echo "image tag unchanged, nothing to commit"
                        else
                            git commit -am "chore(trading-ai-frontend): deploy trading-ai-frontend@${GIT_COMMIT}"
                            git push origin master
                        fi
                    '''
                }
                sh 'rm -rf .cloud-config-bump'
            }
        }

        stage('DAST - OWASP ZAP baseline') {
            when {
                expression { return !env.pr_number?.trim() }
            }
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    sh '''
                        set -euo pipefail
                        mkdir -p zap-out
                        chmod 777 zap-out
                        # Baseline = passive spider + passive scan only, no active attack payloads -
                        # safe to run against the live production site. Do NOT swap this for
                        # zap-full-scan.py against 00x097.com - that actively attacks the target,
                        # only ever run that against a non-production/staging environment.
                        docker run --rm -v "$WORKSPACE/zap-out:/zap/wrk:rw" zaproxy/zap-stable \
                            zap-baseline.py -t https://00x097.com \
                            -r zap-report.html -J zap-report.json || true
                    '''
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'zap-out/**', allowEmptyArchive: true
                }
            }
        }

        stage('PR comment') {
            when {
                expression { return env.pr_number?.trim() }
            }
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'git-gitea-tbs093a',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_TOKEN'
                    )
                ]) {
                    sh '''
                        set -euo pipefail
                        python3 build-pr-comment.py > pr-comment-body.json
                        curl -s -X POST \
                            -H "Authorization: token ${GIT_TOKEN}" \
                            -H "Content-Type: application/json" \
                            -d @pr-comment-body.json \
                            "https://git.00x097.com/api/v1/repos/tbs093a/trading.ai.frontend/issues/${pr_number}/comments"
                    '''
                }
            }
        }
    }
}
